<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Deliberately NOT requested: no INTERNET permission. The app works
         fully offline (flight mode) and never sends anything anywhere. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BillBook">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".NewBillActivity"
            android:exported="false"
            android:label="@string/new_bill" />
        <activity
            android:name=".BillDetailActivity"
            android:exported="false"
            android:label="@string/bill_detail" />
        <activity
            android:name=".ItemsActivity"
            android:exported="false"
            android:label="@string/items_title" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="@string/shop_profile" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
