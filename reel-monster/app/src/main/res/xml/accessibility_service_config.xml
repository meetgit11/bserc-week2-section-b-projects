<?xml version="1.0" encoding="utf-8"?>
<!-- Level 2 automatic counting: only scroll events from Instagram and YouTube.
     canRetrieveWindowContent is false on purpose — the service never reads
     screen text, so it cannot see messages, passwords or anything else. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled"
    android:packageNames="com.instagram.android,com.google.android.youtube"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description" />
